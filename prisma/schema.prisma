generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model Link {
  id        String   @id @default(cuid())
  slug      String   @unique
  url       String
  createdAt DateTime @default(now())
  clicks    Int      @default(0)
  @@index([slug])
}
